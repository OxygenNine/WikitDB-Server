DATABASE_URL=postgresql://user:password@localhost:5432/wikitdb
JWT_SECRET=replace-with-at-least-32-random-bytes
SITE_ORIGIN=https://example.com
TRUST_PROXY=false

# 邮件发信配置（注册验证码）
# 163 邮箱示例：SMTP_HOST=smtp.163.com  SMTP_PORT=465  SMTP_USER=邮箱地址  SMTP_PASS=授权码(非登录密码)
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com  SMTP_PORT=465  SMTP_USER=邮箱地址  SMTP_PASS=授权码
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 可选：强制指定连接模式（不填则按端口推断，465=SSL，587/25=STARTTLS）
# SMTP_SECURE=true
# 可选：自定义发件人地址，默认使用 SMTP_USER
# SMTP_FROM=

WIKIDOT_BOT_USER=
WIKIDOT_BOT_PASS=
